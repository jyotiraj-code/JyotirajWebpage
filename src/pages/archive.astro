---
import Layout from '../layouts/Layout.astro';
import AssameseJaapiMandala from '../components/AssameseJaapiMandala.astro';
---

<Layout title="The Analog Archive: Off-Duty Disciplines" currentPath="/archive/">
  <div class="mb-8 border-b border-paper-pencil dark:border-terminal-wire pb-4">
    <div class="flex items-center gap-2 text-xs font-mono text-paper-red dark:text-terminal-amber mb-1">
      <span>SECTION 06</span>
      <span>//</span>
      <span>ANALOG ARCHIVE &amp; OFF-DUTY DISCIPLINES</span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold tracking-typewriter">THE ANALOG ARCHIVE: POETRY, ACOUSTICS, TERRAIN &amp; PROTOCOLS</h1>
    <p class="text-xs font-mono text-paper-margin dark:text-terminal-muted mt-1">
      Tactile documentation of bilingual Assamese verse, Indian classical percussion talas, New Zealand terrain expeditions, and laboratory coffee extractions.
    </p>
  </div>

  <!-- SECTION 1: LITERARY & POETRY WING -->
  <div id="poetry" class="mb-14">
    <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-6">
      <h2 class="text-sm font-bold tracking-wider">01 // LITERARY &amp; POETRY WING: ASSAMESE &amp; ENGLISH</h2>
      <span class="stamp stamp-verified">[AUTHENTIC SCRIPT]</span>
    </div>

    <div class="ledger-box p-6 md:p-8">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-paper-pencil dark:border-terminal-wire pb-3 mb-6">
        <div>
          <span class="font-bold text-base text-paper-carbon dark:text-terminal-fg">দাপোন // Dapun (Mirror)</span>
          <span class="text-xs text-paper-margin dark:text-terminal-muted ml-2 font-mono">Original Poetry by Jyotiraj Nath</span>
        </div>
        <div class="flex gap-2">
          <span class="stamp stamp-converged">ASSAMESE &bull; ENGLISH</span>
          <span class="stamp stamp-archived">VERIFIED METER</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
        <!-- ASSAMESE ORIGINAL -->
        <div class="p-6 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire">
          <div class="text-xs font-mono text-paper-red dark:text-terminal-amber font-bold mb-3 border-b border-paper-pencil dark:border-terminal-wire pb-1">
            [মূল অসমীয়া পাঠ / ORIGINAL ASSAMESE TEXT]
          </div>
          <div class="font-serif text-lg leading-loose text-paper-carbon dark:text-terminal-fg space-y-4">
            <p>
              <strong>দাপোন</strong>
            </p>
            <p>
              এতিয়াও সময় আছে<br />
              ধূলিৰে ঢকা আইনাখন মচি চোৱাৰ,<br />
              হয়তো তাত দেখা যাব<br />
              হেৰাই যোৱা সেই নদীখনৰ সোঁত—<br />
              যি কেতিয়াবা বৈছিল আমাৰ বুকুত।
            </p>
            <p>
              বতাহজাকে কঢ়িয়াই আনে<br />
              দূৰণিৰ সেউজীয়া সুবাস,<br />
              তুমি কি শুনিছা সেই শব্দ?<br />
              যি শব্দত আজিও সাৰে থাকে<br />
              এটি নিস্তব্ধ বিশ্বাস।
            </p>
          </div>
        </div>

        <!-- ENGLISH TRANSLATION -->
        <div class="p-6 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire">
          <div class="text-xs font-mono text-paper-red dark:text-terminal-amber font-bold mb-3 border-b border-paper-pencil dark:border-terminal-wire pb-1">
            [PARALLEL ENGLISH RENDERING]
          </div>
          <div class="font-serif text-lg leading-loose text-paper-carbon dark:text-terminal-fg space-y-4">
            <p>
              <strong>Mirror (Dapun)</strong>
            </p>
            <p>
              There is still time<br />
              To wipe the dust-covered glass,<br />
              Perhaps therein will be seen<br />
              The current of that lost river—<br />
              Which once flowed through our chest.
            </p>
            <p>
              The wind carries from afar<br />
              The scent of unforgotten green,<br />
              Do you hear that sound?<br />
              The sound in which even now awakens<br />
              A silent, enduring faith.
            </p>
          </div>
        </div>
      </div>

      <div class="text-xs font-mono text-paper-margin dark:text-terminal-muted border-t border-paper-pencil dark:border-terminal-wire pt-3">
        <strong>Typographic Note:</strong> Rendered in native UTF-8 Assamese Unicode script. The motif of the mirror (দাপোন) acts as a reflective manifold between memory, linguistic identity, and diasporic displacement across the southern hemisphere.
      </div>
    </div>

    <!-- CODE-GENERATED ANALOG GRAPHIC: ASSAMESE JAAPI & TALA ACOUSTIC MANDALA -->
    <AssameseJaapiMandala />
  </div>

  <!-- SECTION 2: ACOUSTIC JOURNAL -->
  <div id="tabla" class="mb-14">
    <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-6">
      <h2 class="text-sm font-bold tracking-wider">02 // ACOUSTIC JOURNAL: TABLA RHYTHMS &amp; FREQUENCY LOGS</h2>
      <span class="stamp stamp-converged">[INDIAN CLASSICAL METER]</span>
    </div>

    <div class="space-y-6 font-mono text-xs">
      <!-- TABLA TALAS -->
      <div class="ledger-box p-6">
        <h3 class="font-bold text-sm text-paper-carbon dark:text-terminal-fg mb-4 flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2">
          <span>CLASSICAL PERCUSSION: TABLA TALA STRUCTURES</span>
          <span class="stamp stamp-verified">NORTH INDIAN SYSTEM</span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <!-- TEENTAL -->
          <div class="p-4 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire">
            <div class="font-bold text-paper-red dark:text-terminal-amber mb-2">
              TEENTAL // 16 MATRAS (4+4+4+4)
            </div>
            <div class="text-[11px] space-y-2 leading-relaxed text-paper-carbon dark:text-terminal-fg">
              <div><strong>Vibhag 1 (Sam):</strong> Dha &bull; Dhin &bull; Dhin &bull; Dha</div>
              <div><strong>Vibhag 2 (Tali 2):</strong> Dha &bull; Dhin &bull; Dhin &bull; Dha</div>
              <div><strong>Vibhag 3 (Khali):</strong> Dha &bull; Tin &bull; Tin &bull; Ta</div>
              <div><strong>Vibhag 4 (Tali 3):</strong> Ta &bull; Dhin &bull; Dhin &bull; Dha</div>
              <div class="text-[10px] text-paper-margin dark:text-terminal-muted pt-2 border-t border-paper-pencil dark:border-terminal-wire">
                Characteristics: Symmetrical quad-beat division; fundamental substrate for classical vilambit and drut khyal accompaniments.
              </div>
            </div>
          </div>

          <!-- JHAPTAL -->
          <div class="p-4 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire">
            <div class="font-bold text-paper-red dark:text-terminal-amber mb-2">
              JHAPTAL // 10 MATRAS (2+3+2+3)
            </div>
            <div class="text-[11px] space-y-2 leading-relaxed text-paper-carbon dark:text-terminal-fg">
              <div><strong>Vibhag 1 (Sam):</strong> Dhin &bull; Na</div>
              <div><strong>Vibhag 2 (Tali 2):</strong> Dhin &bull; Dhin &bull; Na</div>
              <div><strong>Vibhag 3 (Khali):</strong> Tin &bull; Na</div>
              <div><strong>Vibhag 4 (Tali 3):</strong> Dhin &bull; Dhin &bull; Na</div>
              <div class="text-[10px] text-paper-margin dark:text-terminal-muted pt-2 border-t border-paper-pencil dark:border-terminal-wire">
                Characteristics: Asymmetric pentameter cadence; demands acute mathematical syncopation during tihai resolution.
              </div>
            </div>
          </div>

          <!-- KEHERWA -->
          <div class="p-4 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire">
            <div class="font-bold text-paper-red dark:text-terminal-amber mb-2">
              KEHERWA // 8 MATRAS (4+4)
            </div>
            <div class="text-[11px] space-y-2 leading-relaxed text-paper-carbon dark:text-terminal-fg">
              <div><strong>Vibhag 1 (Sam):</strong> Dha &bull; Ge &bull; Na &bull; Ti</div>
              <div><strong>Vibhag 2 (Khali):</strong> Na &bull; Ka &bull; Dhi &bull; Na</div>
              <div class="text-[10px] text-paper-margin dark:text-terminal-muted pt-2 border-t border-paper-pencil dark:border-terminal-wire">
                Characteristics: Folk and semi-classical fluid swing; continuous bayan modulation and resonant open syahi strikes.
              </div>
            </div>
          </div>
        </div>

        <!-- HARMONIUM TUNING & LISTENING -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-paper-pencil dark:border-terminal-wire">
          <div>
            <div class="font-bold text-xs uppercase mb-2">HARMONIUM MICROTONAL FREQUENCY LOG</div>
            <p class="text-[11px] text-paper-carbon dark:text-terminal-fg leading-relaxed mb-2">
              Calibration of 3.25-octave reed harmonium to standard pitch $A_4 = 440\,\text{Hz}$ with Just Intonation shruti adjustments for Raag Bhairav ($r_1 = 16/15$, $d_1 = 8/5$) and Raag Kafi ($g_2 = 6/5$, $n_2 = 9/5$).
            </p>
          </div>
          <div>
            <div class="font-bold text-xs uppercase mb-2">MUSICAL RECEPTACLE &amp; LISTENING LOGS</div>
            <p class="text-[11px] text-paper-carbon dark:text-terminal-fg leading-relaxed">
              Curated sonic rotation: <strong>Zubeen Garg</strong> (Assamese modern folk &amp; Borgeet expressions), <strong>Chris Isaak</strong> (vintage tape-echo rockabilly noir), <strong>Kummer</strong> (contemporary German alt-rap / post-punk), and <strong>AnnenMayKantereit</strong> (gravel-toned Cologne indie acoustic).
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3: FIELD PHOTOGRAPHY & TERRAIN LOGS -->
  <div id="terrain" class="mb-14">
    <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-6">
      <h2 class="text-sm font-bold tracking-wider">03 // FIELD PHOTOGRAPHY &amp; TERRAIN DOSSIER</h2>
      <span class="stamp stamp-archived">[EXIF METADATA VERIFIED]</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono text-xs">
      <!-- TERRAIN 1: QUEENSTOWN -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">QUEENSTOWN HILL // SUMMIT SPUR</span>
          <span class="stamp stamp-verified">SOUTH ISLAND</span>
        </div>
        <p class="text-paper-carbon dark:text-terminal-fg leading-relaxed mb-4 text-[11px]">
          Steep ascent through alpine pine canopy emerging onto open schist crags overlooking Lake Wakatipu and the Remarkables range. Harsh alpine light with deep glacial shadows.
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1">
          <div><span class="opacity-60">CAMERA:</span> Google Pixel 8 (Main Sensor f/1.68)</div>
          <div><span class="opacity-60">FOCAL / EXPOSURE:</span> 25mm equiv &bull; 1/2400s &bull; ISO 21</div>
          <div><span class="opacity-60">COORDINATES:</span> 45.0253° S, 168.6738° E &bull; ALT: 907m</div>
        </div>
      </div>

      <!-- TERRAIN 2: AORAKI / MOUNT COOK -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">AORAKI / MOUNT COOK // MUELLER GLACIER</span>
          <span class="stamp stamp-verified">CANTERBURY</span>
        </div>
        <p class="text-paper-carbon dark:text-terminal-fg leading-relaxed mb-4 text-[11px]">
          Rugged glacial moraine ridge facing the sheer ice faces of Mount Sefton and Mount Cook. High contrast monochrome textures of shattered greywacke rock and active ice falls.
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1">
          <div><span class="opacity-60">CAMERA:</span> Analog 35mm Rangefinder (Ilford HP5 Plus 400)</div>
          <div><span class="opacity-60">FOCAL / EXPOSURE:</span> 35mm f/8.0 &bull; 1/1000s &bull; ISO 400</div>
          <div><span class="opacity-60">COORDINATES:</span> 43.7333° S, 170.0967° E &bull; ALT: 1040m</div>
        </div>
      </div>

      <!-- TERRAIN 3: HOOKER VALLEY -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">HOOKER VALLEY TRACK // SWING BRIDGES</span>
          <span class="stamp stamp-verified">ALPINE BASIN</span>
        </div>
        <p class="text-paper-carbon dark:text-terminal-fg leading-relaxed mb-4 text-[11px]">
          Suspension bridges spanning the turbulent, silt-laden Hooker River. Terminal proglacial lake with drifting icebergs under low alpine cloud cover.
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1">
          <div><span class="opacity-60">CAMERA:</span> Google Pixel 8 (Computational HDR Off)</div>
          <div><span class="opacity-60">FOCAL / EXPOSURE:</span> 50mm 2x crop &bull; 1/1200s &bull; f/1.68 &bull; ISO 34</div>
          <div><span class="opacity-60">COORDINATES:</span> 43.7145° S, 170.1032° E &bull; ALT: 880m</div>
        </div>
      </div>

      <!-- TERRAIN 4: WAITAKERE RANGES -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">WAITAKERE RANGES // KAREKARE &amp; PIHA</span>
          <span class="stamp stamp-verified">WEST COAST</span>
        </div>
        <p class="text-paper-carbon dark:text-terminal-fg leading-relaxed mb-4 text-[11px]">
          Heavy iron-sand black dunes, native kauri rainforest gullies (Karamatura track), and towering volcanic Lion Rock battered by Tasman Sea swells.
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1">
          <div><span class="opacity-60">CAMERA:</span> Google Pixel 8 (Analog Emulation Profile)</div>
          <div><span class="opacity-60">FOCAL / EXPOSURE:</span> 25mm f/1.68 &bull; 1/800s &bull; ISO 48</div>
          <div><span class="opacity-60">COORDINATES:</span> 36.9880° S, 174.4789° E &bull; ALT: 24m</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4: PHYSICAL PROTOCOLS & COFFEE EXTRACTION -->
  <div id="coffee" class="mb-12">
    <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-6">
      <h2 class="text-sm font-bold tracking-wider">04 // PHYSICAL PROTOCOLS: LABORATORY COFFEE &amp; STRENGTH SPLIT</h2>
      <span class="stamp stamp-converged">[PARAMETRIC SPECS]</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-mono text-xs">
      <!-- COFFEE EXTRACTION -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">DRIP BAG EXTRACTION PROTOCOL</span>
          <span class="stamp stamp-verified">ES CHOCOLAT</span>
        </div>
        <p class="text-[11px] text-paper-carbon dark:text-terminal-fg leading-relaxed mb-3">
          Precision pour-over parameter curve for single-origin dark roast (ES CHOCOLAT) designed to maximize chocolate/caramel lipids while minimizing bitter polyphenols:
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1 mb-3">
          <div><span class="opacity-60">GROUND DOSE:</span> 12.0g (Precision grind, 650μm)</div>
          <div><span class="opacity-60">TOTAL WATER MASS:</span> 186.0g &bull; Brew Ratio 1:15.5</div>
          <div><span class="opacity-60">WATER TEMPERATURE:</span> 92.5°C (Auckland soft filtered water)</div>
          <div><span class="opacity-60">POUR 1 (BLOOM):</span> 35g &bull; 45s dwell &bull; gentle swirl</div>
          <div><span class="opacity-60">POUR 2 (BODY):</span> 85g &bull; laminar spiral flow to 120g mark</div>
          <div><span class="opacity-60">POUR 3 (FINISH):</span> 66g &bull; steady center pour, drawdown at 2:45</div>
        </div>
        <div class="text-[10px] text-paper-margin dark:text-terminal-muted">
          Target TDS: 1.38% &bull; Extraction Yield: 20.2% &bull; Clean finish, velvet mouthfeel.
        </div>
      </div>

      <!-- STRENGTH SPLIT -->
      <div class="ledger-box p-5">
        <div class="flex items-center justify-between border-b border-paper-pencil dark:border-terminal-wire pb-2 mb-3">
          <span class="font-bold text-sm text-paper-carbon dark:text-terminal-fg">5-DAY STRENGTH &amp; NUTRITIONAL LEDGER</span>
          <span class="stamp stamp-verified">HYPERTROPHY</span>
        </div>
        <p class="text-[11px] text-paper-carbon dark:text-terminal-fg leading-relaxed mb-3">
          Physical conditioning system balancing mental cognitive load in theoretical physics with disciplined mechanical hypertrophy:
        </p>
        <div class="p-3 bg-paper-subtle dark:bg-terminal-subtle border border-paper-pencil dark:border-terminal-wire text-[11px] space-y-1 mb-3">
          <div><span class="opacity-60">SPLIT:</span> Push &bull; Pull &bull; Legs &bull; Upper Power &bull; Conditioning</div>
          <div><span class="opacity-60">OVERLOAD:</span> +2.5% load or +1 rep at RPE 8.0-8.5 weekly</div>
          <div><span class="opacity-60">CORE LIFTS:</span> Barbell squat, weighted pull-up, overhead press</div>
          <div><span class="opacity-60">PROTEIN SOURCES:</span> Fresh paneer, chicken breast, lean mutton</div>
          <div><span class="opacity-60">ERGOGENIC AIDS:</span> Creatine monohydrate 5g/day &bull; 3.5L H2O/day</div>
        </div>
        <div class="text-[10px] text-paper-margin dark:text-terminal-muted">
          Consistency: 96.4% over 52 rolling weeks. Rest days aligned with cluster heavy run submissions.
        </div>
      </div>
    </div>
  </div>
</Layout>

